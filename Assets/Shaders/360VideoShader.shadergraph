        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "EquirectUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "UV = float2(\n    0.5 + atan2(Dir.z, Dir.x) / (2.0 * 3.14159265),\n    0.5 + asin(clamp(Dir.y, -1.0, 1.0)) / 3.14159265\n);"
}

